    echo "Usage:"
    echo "  sheerstatus              Print hardware health & audit verdict"
    echo "  sheerstatus --json       Output JSON for automation"
    echo "  sheerstatus --version    Print version"
    echo "  sheerstatus --help       Print help"
    ;;
  *)
    run_audit
    ;;
esac
