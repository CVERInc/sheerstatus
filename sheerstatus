ss_resolve_lang() {
  local l="${SHEERSTATUS_LANG:-${LANG:-}}"
  [ -z "$l" ] && l="$(defaults read -g AppleLocale 2>/dev/null || true)"
  case "$l" in
    ja*|*ja_JP*|*ja-JP*)                        echo "ja-JP" ;;
    *zh*Hant*|*zh_TW*|*zh-TW*|*zh_HK*|*zh-HK*)  echo "zh-TW" ;;
    zh*|*zh_CN*|*zh-CN*|*zh_SG*|*zh*Hans*)      echo "zh-Hans" ;;
    ko*|*ko_KR*|*ko-KR*)                        echo "ko-KR" ;;
    es*|*es_ES*|*es-ES*|*es_419*)               echo "es-ES" ;;
    de*|*de_DE*|*de-DE*)                        echo "de-DE" ;;
    fr*|*fr_FR*|*fr-FR*|*fr_CA*)                echo "fr-FR" ;;
    pt*|*pt_BR*|*pt-BR*|*pt_PT*)                echo "pt-BR" ;;
    *)                                          echo "en-US" ;;
  esac
}
