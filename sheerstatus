    zh-TW|zh-Hans|ja-JP) echo "  • ${label}：${val}" ;;
    *) echo "  • ${label}: ${val}" ;;
  esac
}

# --- Target Storage Mount Resolver (Prevents network hang & targets max user partition) ---

get_target_mount() {
  if [ "$(uname)" = "Darwin" ]; then
    if [ -d "/System/Volumes/Data" ]; then
      echo "/System/Volumes/Data"
    else
      echo "/"
    fi
  else
    # Linux: Check both / and $HOME partition using local-only df (-hl), pick highest usage %
    local home_dir="${HOME:-/}"
    local root_pct home_pct
    root_pct="$(df -hl / 2>/dev/null | awk 'NR==2 {print $5}' | tr -d '%' || echo 0)"
    home_pct="$(df -hl "$home_dir" 2>/dev/null | awk 'NR==2 {print $5}' | tr -d '%' || echo 0)"
    [ -z "$root_pct" ] && root_pct=0
    [ -z "$home_pct" ] && home_pct=0

    if [ "$home_pct" -gt "$root_pct" ]; then
      echo "$home_dir"
    else
      echo "/"
    fi
  fi
}

# --- Cross-Platform Metrics (macOS + Linux) ---

get_chip_name() {
  if [ "$(uname)" = "Darwin" ]; then
    sysctl -n machdep.cpu.brand_string 2>/dev/null || sysctl -n hw.model 2>/dev/null || echo "Apple Silicon"
  else
    local cpu_name
    cpu_name="$(grep -m1 "model name" /proc/cpuinfo 2>/dev/null | cut -d: -f2 | sed 's/^\s*//' || true)"
    if [ -z "$cpu_name" ] && [ -f /sys/firmware/devicetree/base/model ]; then
      cpu_name="$(tr -d '\0' < /sys/firmware/devicetree/base/model 2>/dev/null || true)"
    fi
    [ -z "$cpu_name" ] && cpu_name="$(uname -m 2>/dev/null || echo "Linux Processor")"
    echo "$cpu_name"
  fi
}

get_ram_gb() {
  if [ "$(uname)" = "Darwin" ]; then
    local bytes gb
    bytes="$(sysctl -n hw.memsize 2>/dev/null || echo 0)"
    gb=$(( bytes / 1073741824 ))
    echo "${gb} GB"
  else
    local kb gb
    kb="$(awk '/MemTotal:/ {print $2}' /proc/meminfo 2>/dev/null || echo 0)"
    gb=$(( kb / 1048576 ))
    echo "${gb} GB"
  fi
}

get_ssd_size() {
  local mount_path
  mount_path="$(get_target_mount)"

  local raw_df
  # Force local-only df (-hl) to prevent NFS network mount hangs
  raw_df="$(df -hl "$mount_path" 2>/dev/null | awk 'NR==2 {print $2}')"
  raw_df="${raw_df%Gi}"
  raw_df="${raw_df%G}"
  raw_df="${raw_df%Ti}"
  raw_df="${raw_df%T}"

  echo "${raw_df} GB Disk"
}

get_swap_formatted() {
  if [ "$(uname)" = "Darwin" ]; then
    local swap_line used_mb total_mb used_gb total_gb
    swap_line="$(sysctl -n vm.swapusage 2>/dev/null || echo "")"
    if [ -z "$swap_line" ]; then
      echo "N/A"
      return
    fi
    used_mb="$(echo "$swap_line" | awk '{for(i=1;i<=NF;i++) if($i=="used") print $(i+2)}' | tr -d 'M' | cut -d. -f1)"
    total_mb="$(echo "$swap_line" | awk '{for(i=1;i<=NF;i++) if($i=="total") print $(i+2)}' | tr -d 'M' | cut -d. -f1)"

    [ -z "$used_mb" ] && used_mb=0
    [ -z "$total_mb" ] && total_mb=0

    if [ "$used_mb" -eq 0 ]; then
      echo "0 B"
    else
      used_gb="$(awk "BEGIN {printf \"%.2f\", $used_mb/1024}")"
      total_gb="$(awk "BEGIN {printf \"%.2f\", $total_mb/1024}")"
      echo "${used_gb} / ${total_gb} GB"
    fi
  else
    local st_kb sf_kb su_kb used_gb total_gb
    st_kb="$(awk '/SwapTotal:/ {print $2}' /proc/meminfo 2>/dev/null || echo 0)"
    sf_kb="$(awk '/SwapFree:/ {print $2}' /proc/meminfo 2>/dev/null || echo 0)"
    su_kb=$(( st_kb - sf_kb ))
    [ "$su_kb" -lt 0 ] && su_kb=0

    if [ "$su_kb" -eq 0 ]; then
      echo "0 B"
    else
      used_gb="$(awk "BEGIN {printf \"%.2f\", $su_kb/1048576}")"
      total_gb="$(awk "BEGIN {printf \"%.2f\", $st_kb/1048576}")"
      echo "${used_gb} / ${total_gb} GB"
    fi
  fi
}

get_disk_formatted() {
  local mount_path
  mount_path="$(get_target_mount)"

  local used_df total_df pct
  # Force local-only df (-hl) to prevent NFS network mount hangs
  used_df="$(df -hl "$mount_path" 2>/dev/null | awk 'NR==2 {print $3}')"
  total_df="$(df -hl "$mount_path" 2>/dev/null | awk 'NR==2 {print $2}')"
  pct="$(df -hl "$mount_path" 2>/dev/null | awk 'NR==2 {print $5}')"

  used_df="${used_df%Gi}"
  used_df="${used_df%G}"
  total_df="${total_df%Gi}"
  total_df="${total_df%G}"

  echo "${used_df} / ${total_df} GB (${pct})"
}

get_disk_pct_num() {
  local mount_path
  mount_path="$(get_target_mount)"
  # Force local-only df (-hl)
  df -hl "$mount_path" 2>/dev/null | awk 'NR==2 {print $5}' | tr -d '%' | cut -d. -f1
}

get_temp_live() {
  if [ "$(uname)" = "Darwin" ]; then
    local raw
    raw="$(ioreg -rn AppleSmartBattery 2>/dev/null | awk -F'= ' '/"Temperature" =/ {print $2}' | head -n1)"
    if [ -n "$raw" ]; then
      awk "BEGIN {printf \"%.1f\", $raw/100}"
    else
      echo "N/A"
    fi
  else
    local t_path
    t_path="$(ls /sys/class/thermal/thermal_zone*/temp 2>/dev/null | head -n1 || true)"
    if [ -n "$t_path" ] && [ -f "$t_path" ]; then
      local raw
      raw="$(cat "$t_path" 2>/dev/null || echo 0)"
      awk "BEGIN {printf \"%.1f\", $raw/1000}"
    else
      echo "N/A"
    fi
  fi
}

get_temp_max() {
  if [ "$(uname)" = "Darwin" ]; then
    local raw
    raw="$(ioreg -rn AppleSmartBattery 2>/dev/null | grep -o '"MaximumTemperature"=[0-9]*' | cut -d= -f2 | head -n1 || true)"
    if [ -n "$raw" ]; then
      echo "${raw} °C"
    else
      echo "N/A"
    fi
  else
    echo "N/A"
  fi
}

get_temp_avg() {
  if [ "$(uname)" = "Darwin" ]; then
    local raw
    raw="$(ioreg -rn AppleSmartBattery 2>/dev/null | grep -o '"AverageTemperature"=[0-9]*' | cut -d= -f2 | head -n1 || true)"
    if [ -n "$raw" ]; then
      awk "BEGIN {printf \"%.1f\", $raw/10}"
    else
      echo "N/A"
    fi
  else
    echo "N/A"
  fi
}

get_battery_pct() {
  if [ "$(uname)" = "Darwin" ]; then
    local raw_max max_cap design_cap
    raw_max="$(ioreg -rn AppleSmartBattery 2>/dev/null | grep -o '"AppleRawMaxCapacity"=[0-9]*' | cut -d= -f2 | head -n1 || true)"
    design_cap="$(ioreg -rn AppleSmartBattery 2>/dev/null | grep -o '"DesignCapacity"=[0-9]*' | cut -d= -f2 | head -n1 || true)"
    
    if [ -n "$raw_max" ] && [ -n "$design_cap" ] && [ "$design_cap" -gt 0 ]; then
      local pct=$(( raw_max * 100 / design_cap ))
      [ "$pct" -gt 100 ] && pct=100
      echo "${pct}%"
    else
      max_cap="$(ioreg -rn AppleSmartBattery 2>/dev/null | grep -o '"MaxCapacity"=[0-9]*' | cut -d= -f2 | head -n1 || true)"
      if [ -n "$max_cap" ]; then
        echo "${max_cap}%"
      else
        echo "N/A"
      fi
    fi
  else
    # Linux multi-battery support (average capacity across all BAT nodes)
    local caps=0 count=0 cap
    for cap_path in /sys/class/power_supply/*/capacity; do
      if [ -f "$cap_path" ]; then
        cap="$(cat "$cap_path" 2>/dev/null || echo 0)"
        caps=$(( caps + cap ))
        count=$(( count + 1 ))
      fi
    done
    if [ "$count" -gt 0 ]; then
      local avg_cap=$(( caps / count ))
      echo "${avg_cap}%"
    else
      echo "N/A"
    fi
  fi
}

get_battery_pct_num() {
  get_battery_pct | tr -d '%' | cut -d. -f1
}

get_battery_cycles() {
  if [ "$(uname)" = "Darwin" ]; then
    local cycle_cnt
    cycle_cnt="$(ioreg -rn AppleSmartBattery 2>/dev/null | grep -o '"CycleCount"=[0-9]*' | cut -d= -f2 | head -n1 || true)"
    if [ -n "$cycle_cnt" ]; then
      case "$SS_LANG" in
        zh-TW|zh-Hans) echo "${cycle_cnt} 次" ;;
        ja-JP) echo "${cycle_cnt} 回" ;;
        *) echo "${cycle_cnt}" ;;
      esac
    else
      echo "N/A"
    fi
  else
    # Linux multi-battery support (sum cycles across all BAT nodes)
    local total_cycles=0 count=0 cyc
    for cyc_path in /sys/class/power_supply/*/cycle_count; do
      if [ -f "$cyc_path" ]; then
        cyc="$(cat "$cyc_path" 2>/dev/null || echo 0)"
        if [ "$cyc" -gt 0 ]; then
          total_cycles=$(( total_cycles + cyc ))
          count=$(( count + 1 ))
        fi
      fi
    done
    if [ "$count" -gt 0 ]; then
      case "$SS_LANG" in
        zh-TW|zh-Hans) echo "${total_cycles} 次" ;;
        ja-JP) echo "${total_cycles} 回" ;;
        *) echo "${total_cycles}" ;;
      esac
    else
      echo "N/A"
    fi
  fi
}

get_swap_used_mb() {
  if [ "$(uname)" = "Darwin" ]; then
    sysctl -n vm.swapusage 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="used") print $(i+2)}' | tr -d 'M' | cut -d. -f1
  else
    local st_kb sf_kb su_kb
    st_kb="$(awk '/SwapTotal:/ {print $2}' /proc/meminfo 2>/dev/null || echo 0)"
    sf_kb="$(awk '/SwapFree:/ {print $2}' /proc/meminfo 2>/dev/null || echo 0)"
    su_kb=$(( st_kb - sf_kb ))
    [ "$su_kb" -lt 0 ] && su_kb=0
    echo $(( su_kb / 1024 ))
  fi
}

# --- Audit Verdict Builder ---

build_verdict_line_memory() {
  local swap_mb ram
  swap_mb="$1"
  ram="$2"

  if [ "$swap_mb" -lt 500 ]; then
    case "$SS_LANG" in
      zh-TW|zh-Hans) echo "  • $(t tag_pass) $(t name_memory)：無 Swap 負擔（當前 ${ram}）。" ;;
      ja-JP) echo "  • $(t tag_pass) $(t name_memory)：Swap 負荷なし（現在 ${ram}）。" ;;
      ko-KR) echo "  • $(t tag_pass) $(t name_memory)：Swap 부하 없음(현재 ${ram})." ;;
      *) echo "  • $(t tag_pass) $(t name_memory): No swap load (current: ${ram})." ;;
    esac
  elif [ "$swap_mb" -lt 3000 ]; then
    local swap_fmt
    swap_fmt="$(get_swap_formatted)"
    case "$SS_LANG" in
      zh-TW|zh-Hans) echo "  • $(t tag_warn) $(t name_memory)：Swap 已用 ${swap_fmt}（當前 ${ram}）。" ;;
      ja-JP) echo "  • $(t tag_warn) $(t name_memory)：Swap 使用中 ${swap_fmt}（現在 ${ram}）。" ;;
      ko-KR) echo "  • $(t tag_warn) $(t name_memory)：Swap 사용 중 ${swap_fmt}(현재 ${ram})." ;;
      *) echo "  • $(t tag_warn) $(t name_memory): Swap in use ${swap_fmt} (current: ${ram})." ;;
    esac
  else
    local swap_fmt
    swap_fmt="$(get_swap_formatted)"
    case "$SS_LANG" in
      zh-TW|zh-Hans) echo "  • $(t tag_crit) $(t name_memory)：Swap 嚴重過載 ${swap_fmt}（當前 ${ram}）。" ;;
      ja-JP) echo "  • $(t tag_crit) $(t name_memory)：Swap 深刻な過負荷 ${swap_fmt}（現在 ${ram}）。" ;;
      ko-KR) echo "  • $(t tag_crit) $(t name_memory)：Swap 심각한 부하 ${swap_fmt}(현재 ${ram})." ;;
      *) echo "  • $(t tag_crit) $(t name_memory): Heavy swap thrashing ${swap_fmt} (current: ${ram})." ;;
    esac
  fi
}

