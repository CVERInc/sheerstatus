  if [ "$bat_pct" -ge 80 ]; then
    case "$SS_LANG" in
      zh-TW|zh-Hans) echo "  • $(t tag_pass) $(t name_battery)：健康度良好（${bat_pct}%）。" ;;
      ja-JP) echo "  • $(t tag_pass) $(t name_battery)：健康度良好（${bat_pct}%）。" ;;
      ko-KR) echo "  • $(t tag_pass) $(t name_battery)：성능 상태 양호(${bat_pct}%)." ;;
      *) echo "  • $(t tag_pass) $(t name_battery): Health good (${bat_pct}%)." ;;
    esac
  elif [ "$bat_pct" -ge 70 ]; then
    case "$SS_LANG" in
      zh-TW|zh-Hans) echo "  • $(t tag_warn) $(t name_battery)：健康度衰退（${bat_pct}%）。" ;;
      ja-JP) echo "  • $(t tag_warn) $(t name_battery)：健康度低下（${bat_pct}%）。" ;;
      ko-KR) echo "  • $(t tag_warn) $(t name_battery)：성능 저하(${bat_pct}%)." ;;
      *) echo "  • $(t tag_warn) $(t name_battery): Health degraded (${bat_pct}%)." ;;
    esac
  else
    case "$SS_LANG" in
      zh-TW|zh-Hans) echo "  • $(t tag_crit) $(t name_battery)：健康度嚴重衰退（${bat_pct}%）。" ;;
      ja-JP) echo "  • $(t tag_crit) $(t name_battery)：健康度深刻な低下（${bat_pct}%）。" ;;
      ko-KR) echo "  • $(t tag_crit) $(t name_battery)：배터리 심각 저하(${bat_pct}%)." ;;
      *) echo "  • $(t tag_crit) $(t name_battery): Health severely degraded (${bat_pct}%)." ;;
    esac
  fi
}

build_consolidated_recommendation() {
  local swap_mb disk_pct bat_pct ram_mb
  swap_mb="$1"
  disk_pct="$2"
  bat_pct="$3"
  ram_mb="$4"
  [ -z "$bat_pct" ] || [ "$bat_pct" = "N/A" ] && bat_pct=100

  # Future-proof ratio thresholds
  local pass_threshold=$(( ram_mb * 5 / 100 ))
  [ "$pass_threshold" -lt 200 ] && pass_threshold=200

  local need_ram=0 need_ssd=0 need_bat=0
  [ "$swap_mb" -ge "$pass_threshold" ] && need_ram=1
  [ "$disk_pct" -ge 85 ] && need_ssd=1
  [ "$bat_pct" -lt 80 ] && need_bat=1

  case "$SS_LANG" in
    zh-TW|zh-Hans) echo "建議" ;;
    ja-JP) echo "推奨" ;;
    ko-KR) echo "권장" ;;
    *) echo "Recommendation" ;;
  esac

  if [ "$need_ram" -eq 0 ] && [ "$need_ssd" -eq 0 ] && [ "$need_bat" -eq 0 ]; then
    case "$SS_LANG" in
      zh-TW|zh-Hans) echo "  • 硬體狀態極佳，目前完全無升級或換機需求。" ;;
      ja-JP) echo "  • ハードウェア状態は非常に良好です。買い替えの必要はありません。" ;;
      ko-KR) echo "  • 하드웨어 상태가 매우 양호합니다. 현재 교체가 필요하지 않습니다." ;;
      *) echo "  • Hardware is in excellent condition. No upgrade needed." ;;
    esac
  else
    case "$SS_LANG" in
      zh-TW|zh-Hans)
        local rec="  • 若常感卡頓，下次換機請加大"
        if [ "$need_ram" -eq 1 ] && [ "$need_ssd" -eq 1 ]; then
          echo "${rec}記憶體與硬碟容量。"
        elif [ "$need_ram" -eq 1 ]; then
          echo "${rec}記憶體。"
        elif [ "$need_ssd" -eq 1 ]; then
          echo "${rec}硬碟容量。"
        fi
        
        if [ "$need_bat" -eq 1 ]; then
          echo "  • 請評估更換電池或規劃更換新電腦。"
        fi
        
        if [ "$disk_pct" -ge 85 ]; then
          echo "  • 可考慮使用 sheersweep 整理硬碟空間。"
        fi
        ;;
      ja-JP)
        local rec="  • 日常の動作で遅延を感じる場合は、次回購入時に"
        if [ "$need_ram" -eq 1 ] && [ "$need_ssd" -eq 1 ]; then
          echo "${rec}上位のメモリおよびストレージ容量を推奨します。"
        elif [ "$need_ram" -eq 1 ]; then
          echo "${rec}上位のメモリ容量を推奨します。"
        elif [ "$need_ssd" -eq 1 ]; then
          echo "${rec}上位のストレージ容量を推奨します。"
        fi
        
        if [ "$need_bat" -eq 1 ]; then
          echo "  • バッテリー交換または新しい PC への買い替えを検討してください。"
        fi
        
        if [ "$disk_pct" -ge 85 ]; then
          echo "  • sheersweep を使用してストレージを整理することを検討してください。"
        fi
        ;;
      ko-KR)
        local rec="  • 지속적인 지연이 발생하면 다음 기기 구매 시 "
        if [ "$need_ram" -eq 1 ] && [ "$need_ssd" -eq 1 ]; then
          echo "${rec}더 큰 RAM과 저장 공간을 고려하세요."
        elif [ "$need_ram" -eq 1 ]; then
          echo "${rec}더 큰 RAM을 고려하세요."
        elif [ "$need_ssd" -eq 1 ]; then
          echo "${rec}더 큰 저장 공간을 고려하세요."
        fi
        
        if [ "$need_bat" -eq 1 ]; then
          echo "  • 배터리 교체 또는 새 기기로의 업그레이드를 고려하세요."
        fi
        
        if [ "$disk_pct" -ge 85 ]; then
          echo "  • sheersweep을 사용하여 저장 공간을 확보하는 것을 고려하세요."
        fi
        ;;
      *)
        local rec="  • If lag persists, consider upgrading "
        if [ "$need_ram" -eq 1 ] && [ "$need_ssd" -eq 1 ]; then
          echo "${rec}RAM and storage on your next machine."
        elif [ "$need_ram" -eq 1 ]; then
          echo "${rec}RAM on your next machine."
        elif [ "$need_ssd" -eq 1 ]; then
          echo "${rec}storage on your next machine."
        fi
        
        if [ "$need_bat" -eq 1 ]; then
          echo "  • Consider replacing the battery or upgrading to a new machine."
        fi
        
        if [ "$disk_pct" -ge 85 ]; then
          echo "  • Consider using sheersweep to free up disk space."
        fi
        ;;
    esac
  fi
}

# --- Run Audit Output ---

run_audit() {
  local target_mount chip ram ssd disk_fmt temp_live temp_max temp_avg bat_pct bat_cycles swap_used_mb disk_pct_num bat_pct_num ram_mb
  
  target_mount="$(get_target_mount)"
  chip="$(get_chip_name)"
  ram="$(get_ram_gb)"
  ram_mb="$(get_ram_mb)"
  ssd="$(get_ssd_size "$target_mount")"
  disk_fmt="$(get_disk_formatted "$target_mount")"
  temp_live="$(get_temp_live)"
  temp_max="$(get_temp_max)"
  temp_avg="$(get_temp_avg)"
  bat_pct="$(get_battery_pct)"
  bat_cycles="$(get_battery_cycles)"
  swap_used_mb="$(get_swap_used_mb)"
  disk_pct_num="$(get_disk_pct_num "$target_mount")"
  bat_pct_num="$(get_battery_pct_num)"
  [ -z "$swap_used_mb" ] && swap_used_mb=0
  [ -z "$disk_pct_num" ] && disk_pct_num=0

  # Single Block Flush Output
  {
    echo "============================================================"
    t banner_title
    pad_row "$(t sec_header)" "${chip} ($(t name_memory) ${ram} · $(t name_storage) ${ssd})"
    echo ""
    t sec_storage
    pad_row "$(t label_storage_usage)" "${disk_fmt}"
    if [ "$bat_pct" != "N/A" ] && [ -n "$bat_pct" ]; then
      echo ""
      t sec_battery
      if [ "$temp_live" != "N/A" ]; then
        pad_row "$(t label_temp_live)" "${temp_live} °C"
      else
        pad_row "$(t label_temp_live)" "N/A"
      fi
      if [ "$temp_avg" != "N/A" ]; then
        pad_row "$(t label_temp_avg)" "${temp_avg} °C"
      else
        pad_row "$(t label_temp_avg)" "N/A"
      fi
      pad_row "$(t label_temp_max)" "${temp_max}"
      pad_row "$(t label_cycles)" "${bat_cycles}"
    fi
    echo ""
    echo "------------------------------------------------------------"
    t verdict_title
    build_verdict_line_memory "$swap_used_mb" "$ram_mb"
    build_verdict_line_storage "$disk_pct_num"
    build_verdict_line_battery "$bat_pct_num"
    echo ""
    build_consolidated_recommendation "$swap_used_mb" "$disk_pct_num" "$bat_pct_num" "$ram_mb"
    echo "============================================================"
  }
}

run_json() {
  local target_mount chip ram ssd temp_live temp_max temp_avg swap_used_mb disk_pct_num bat_pct_num
  target_mount="$(get_target_mount)"
  chip="$(get_chip_name)"
  ram="$(get_ram_gb)"
  ssd="$(get_ssd_size "$target_mount")"
  temp_live="$(get_temp_live)"
  temp_max="$(get_temp_max)"
  temp_avg="$(get_temp_avg)"
  swap_used_mb="$(get_swap_used_mb)"
  disk_pct_num="$(get_disk_pct_num "$target_mount")"
  bat_pct_num="$(get_battery_pct_num)"
  [ -z "$swap_used_mb" ] && swap_used_mb=0

  # Strict JSON escaping for potentially untrusted hardware string outputs
  local json_chip="${chip//\"/\\\"}"
  local json_ram="${ram//\"/\\\"}"
  local json_ssd="${ssd//\"/\\\"}"

  cat <<EOF
{
  "version": "${VERSION}",
  "os": "$(uname)",
  "chip": "${json_chip}",
  "ram": "${json_ram}",
  "ssd": "${json_ssd}",
  "swap_used_mb": ${swap_used_mb},
  "disk_used_pct": ${disk_pct_num},
  "battery_health_pct": "${bat_pct_num}",
  "temp_live_c": "${temp_live}",
  "temp_avg_c": "${temp_avg}",
  "temp_max_c": "${temp_max}"
}
EOF
}

# CLI Router
case "${1:-}" in
  --json)
    run_json
    ;;
  --version|-v)
    echo "sheerstatus v${VERSION}"
    ;;
  --help|-h)
    echo "sheerstatus — the zero-daemon hardware & pre-upgrade auditor you can read."
    echo ""
    echo "Usage:"
    echo "  sheerstatus              Print hardware health & audit verdict"
    echo "  sheerstatus --json       Output JSON for automation"
    echo "  sheerstatus --version    Print version"
    echo "  sheerstatus --help       Print help"
    ;;
  *)
    run_audit
    ;;
esac
