get_swap_used_mb() {
  if [ "$(uname)" = "Darwin" ]; then
    sysctl -n vm.swapusage 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="used") print $(i+2)}' | tr -d 'M' | cut -d. -f1
  else
    local st_kb sf_kb su_kb
    st_kb="$(awk '/SwapTotal:/ {print $2}' /proc/meminfo 2>/dev/null || echo 0)"
    sf_kb="$(awk '/SwapFree:/ {print $2}' /proc/meminfo 2>/dev/null || echo 0)"
    su_kb=$(( st_kb - sf_kb ))
    [ "$su_kb" -lt 0 ] && su_kb=0
    echo $(( su_kb / 1024 ))
  fi
}

# How much of RAM the kernel says it can still hand out WITHOUT swapping.
#
# Linux only, and it exists because swap-used is not a universal signal: the
# PineNote's kernel is built with `CONFIG_SWAP is not set`, so SwapTotal is 0
# for a STRUCTURAL reason and can never move. Reading that 0 as "ample" printed
# [ PASS ] on a 3.6 GB machine with no cushion at all — a gauge whose needle is
# welded to green. MemAvailable is the kernel's own estimate and it stays honest
# whether or not swap exists.
#
# Empty on macOS: there the compressor+swap pair is the instrument, and inventing
# a number here would be worse than admitting the signal is platform-specific.
get_mem_avail_pct() {
  [ "$(uname)" = "Darwin" ] && return 0
  awk '/MemTotal:/{t=$2} /MemAvailable:/{a=$2} END{if (t>0 && a>0) printf "%d", a*100/t}' /proc/meminfo 2>/dev/null
}

# Does this kernel have a swap subsystem at all? (macOS always does.)
get_has_swap() {
  if [ "$(uname)" = "Darwin" ]; then echo 1; return 0; fi
  local st_kb
  st_kb="$(awk '/SwapTotal:/ {print $2}' /proc/meminfo 2>/dev/null || echo 0)"
  if [ "${st_kb:-0}" -gt 0 ]; then echo 1; else echo 0; fi
}

# --- Audit Verdict Builder ---

# --- Verdict, decided once ---------------------------------------------------
#
# WHICH tier this machine is in is one question; how to SAY it is another. They
# were the same code, so `--json` — the fourth renderer of the same roles — had
# no way to carry the verdict at all, and shipped without the one thing this
# tool exists to produce. These three answer the question; the line builders and
# the JSON both ask them.
#
# The words are the family's closed badge set (signet/packages/cli/SPEC.md):
# pass · warn · crit.
verdict_memory() {   # $1 = swap MB  $2 = total RAM MB
  local swap_mb="$1" ram_mb="$2"
  local pass_threshold=$(( ram_mb * 5 / 100 ))
  [ "$pass_threshold" -lt 200 ] && pass_threshold=200
  if   [ "$swap_mb" -lt "$pass_threshold" ]; then echo pass
  elif [ "$swap_mb" -lt 3000 ];              then echo warn
  else                                            echo crit
  fi
}

# The headroom tier. Thresholds are about what is left, not what was spent —
# which is why this one works on a machine that cannot spend swap at all.
verdict_memory_avail() {   # $1 = MemAvailable as % of MemTotal ("" = no such signal here)
  case "${1:-}" in ''|*[!0-9]*) echo unknown; return 0 ;; esac
  if   [ "$1" -ge 25 ]; then echo pass
  elif [ "$1" -ge 10 ]; then echo warn
  else                       echo crit
  fi
}

verdict_rank() {   # for comparing two tiers; unknown ranks below pass so it never wins
  case "$1" in pass) echo 1 ;; warn) echo 2 ;; crit) echo 3 ;; *) echo 0 ;; esac
}

# Two instruments, one answer: whichever says worse. A machine can be in trouble
# by either road — already paying for swap, or about to run out with none — and
# claiming the better of the two would be picking the flattering gauge.
verdict_memory_both() {   # $1 = swap MB  $2 = ram MB  $3 = avail % (may be empty)
  local a b
  a="$(verdict_memory "$1" "$2")"
  b="$(verdict_memory_avail "${3:-}")"
  if [ "$(verdict_rank "$b")" -gt "$(verdict_rank "$a")" ]; then echo "$b"; else echo "$a"; fi
}

verdict_storage() {   # $1 = used %
  if   [ "$1" -lt 85 ]; then echo pass
  elif [ "$1" -lt 95 ]; then echo warn
  else                       echo crit
  fi
}

verdict_battery() {   # $1 = health % (or N/A)
  case "$1" in ''|N/A|*[!0-9]*) echo unknown; return 0 ;; esac
  if   [ "$1" -ge 80 ]; then echo pass
  elif [ "$1" -ge 70 ]; then echo warn
  else                       echo crit
  fi
}

build_verdict_line_memory() {
  local swap_mb ram_mb avail has_swap v v_swap v_avail m b val
  swap_mb="$1"
  ram_mb="$2"
  avail="$(get_mem_avail_pct)"
  has_swap="$(get_has_swap)"

  v_swap="$(verdict_memory "$swap_mb" "$ram_mb")"
  v_avail="$(verdict_memory_avail "$avail")"
  v="$(verdict_memory_both "$swap_mb" "$ram_mb" "$avail")"

  # WHICH sentence: the one that belongs to the instrument that saw the trouble.
  # A machine with no swap must never be described in swap words — "started using
  # disk as virtual memory" is not a thing it can do — and a swap machine whose
  # headroom is the worse reading must not be summarised as "Ample (Swap 0 B)".
  if [ "$has_swap" -eq 0 ] || [ "$(verdict_rank "$v_avail")" -gt "$(verdict_rank "$v_swap")" ]; then
    val="${avail}%"
    case "$v" in
      pass) m="$(t vd_mem_pass_avail)"; b="$(t tag_pass)" ;;
      warn) m="$(t vd_mem_warn_avail)"; b="$(t tag_warn)" ;;
      *)    m="$(t vd_mem_crit_avail)"; b="$(t tag_crit)" ;;
    esac
    # the cliff is only worth naming when there is one and you are near it
    [ "$has_swap" -eq 0 ] && [ "$v" != "pass" ] && m="${m}$(t vd_mem_noswap)"
  else
    val="$(get_swap_formatted)"
    case "$v" in
      pass) m="$(t vd_mem_pass)"; b="$(t tag_pass)" ;;
      warn) m="$(t vd_mem_warn)"; b="$(t tag_warn)" ;;
      *)    m="$(t vd_mem_crit)"; b="$(t tag_crit)" ;;
    esac
  fi
  printf '   %s %s%s%s\n' "$b" "$(t name_memory)" "$(t sep_colon)" "${m//\{v\}/$val}"
}

build_verdict_line_storage() {
  local disk_pct m b
  disk_pct="$1"

  case "$(verdict_storage "$disk_pct")" in
    pass) m="$(t vd_ssd_pass)"; b="$(t tag_pass)" ;;
    warn) m="$(t vd_ssd_warn)"; b="$(t tag_warn)" ;;
    *)    m="$(t vd_ssd_crit)"; b="$(t tag_crit)" ;;
  esac
  printf '   %s %s%s%s\n' "$b" "$(t name_storage)" "$(t sep_colon)" "${m//\{v\}/$disk_pct}"
}

build_verdict_line_battery() {
  local bat_pct m b
  bat_pct="$1"

  case "$(verdict_battery "$bat_pct")" in
    pass) m="$(t vd_bat_pass)"; b="$(t tag_pass)" ;;
    warn) m="$(t vd_bat_warn)"; b="$(t tag_warn)" ;;
    *)    m="$(t vd_bat_crit)"; b="$(t tag_crit)" ;;
  esac
  printf '   %s %s%s%s\n' "$b" "$(t name_battery)" "$(t sep_colon)" "${m//\{v\}/$bat_pct}"
}

build_consolidated_recommendation() {
  local swap_mb disk_pct bat_pct ram_mb
  swap_mb="$1"
  disk_pct="$2"
  bat_pct="$3"
  ram_mb="$4"
  [ -z "$bat_pct" ] || [ "$bat_pct" = "N/A" ] && bat_pct=100

  # Future-proof ratio thresholds
  local pass_threshold=$(( ram_mb * 5 / 100 ))
  [ "$pass_threshold" -lt 200 ] && pass_threshold=200

  local need_ram=0 need_ssd=0 need_bat=0
  # Either instrument can call for more RAM: swap already being paid for, or
  # headroom running out with no swap to pay with.
  [ "$(verdict_memory_both "$swap_mb" "$ram_mb" "$(get_mem_avail_pct)")" != "pass" ] && need_ram=1
  [ "$disk_pct" -ge 85 ] && need_ssd=1
  [ "$bat_pct" -lt 80 ] && need_bat=1

  # One logic path, nine locales. Which sentence to say is a decision about this
  # machine; which words to say it in is a lookup. Keeping those separate is why
  # a new language is now a translation and not a patch.
  sec "$(t rec_title)"

  if [ "$need_ram" -eq 0 ] && [ "$need_ssd" -eq 0 ] && [ "$need_bat" -eq 0 ]; then
    echo "   · $(t rec_none)"
    return 0
  fi

  if [ "$need_ram" -eq 1 ] && [ "$need_ssd" -eq 1 ]; then
    echo "   · $(t rec_upgrade_both)"
  elif [ "$need_ram" -eq 1 ]; then
    echo "   · $(t rec_upgrade_ram)"
  elif [ "$need_ssd" -eq 1 ]; then
    echo "   · $(t rec_upgrade_ssd)"
  fi

  [ "$need_bat" -eq 1 ] && echo "   · $(t rec_battery)"
  [ "$disk_pct" -ge 85 ] && echo "   · $(t rec_sweep)"
  return 0
}

# --- Run Audit Output ---

run_audit() {
  local target_mount chip ram ssd disk_fmt temp_live temp_max temp_avg bat_pct bat_cycles swap_used_mb disk_pct_num bat_pct_num ram_mb
  
  target_mount="$(get_target_mount)"
  chip="$(get_chip_name)"
  ram="$(get_ram_gb)"
  ram_mb="$(get_ram_mb)"
  ssd="$(get_ssd_size "$target_mount")"
  disk_fmt="$(get_disk_formatted "$target_mount")"
  temp_live="$(get_temp_live)"
  temp_max="$(get_temp_max)"
  temp_avg="$(get_temp_avg)"
  bat_pct="$(get_battery_pct)"
  bat_cycles="$(get_battery_cycles)"
  swap_used_mb="$(get_swap_used_mb)"
  disk_pct_num="$(get_disk_pct_num "$target_mount")"
  bat_pct_num="$(get_battery_pct_num)"
  [ -z "$swap_used_mb" ] && swap_used_mb=0
  [ -z "$disk_pct_num" ] && disk_pct_num=0

  # Single Block Flush Output
  {
    t banner_title
    pad_row "$(t sec_header)" "${chip} ($(t name_memory) ${ram} · $(t name_storage) ${ssd})"
    echo ""
    sec "$(t sec_storage)"
    pad_row "$(t label_storage_usage)" "${disk_fmt}"
    if [ "$bat_pct" != "N/A" ] && [ -n "$bat_pct" ]; then
      echo ""
      sec "$(t sec_battery)"
      
      local cap_str
      cap_str="$(get_battery_capacity_string)"
      if [ "$cap_str" != "N/A" ]; then
        pad_row "$(t label_capacity)" "${cap_str}"
      fi

      if [ "$temp_live" != "N/A" ]; then
        pad_row "$(t label_temp_live)" "${temp_live} °C"
      fi
      if [ "$temp_avg" != "N/A" ]; then
        pad_row "$(t label_temp_avg)" "${temp_avg} °C"
      fi
      if [ "$temp_max" != "N/A" ]; then
        pad_row "$(t label_temp_max)" "${temp_max} °C"
      fi
      if [ "$bat_cycles" != "N/A" ]; then
        pad_row "$(t label_cycles)" "${bat_cycles}"
      fi
    fi
    echo ""
    sec "$(t verdict_title)"
    build_verdict_line_memory "$swap_used_mb" "$ram_mb"
    build_verdict_line_storage "$disk_pct_num"
    build_verdict_line_battery "$bat_pct_num"
    echo ""
    build_consolidated_recommendation "$swap_used_mb" "$disk_pct_num" "$bat_pct_num" "$ram_mb"
  }
}

run_json() {
  local target_mount chip ram ssd temp_live temp_max temp_avg swap_used_mb disk_pct_num bat_pct_num
  target_mount="$(get_target_mount)"
  chip="$(get_chip_name)"
  ram="$(get_ram_gb)"
  ssd="$(get_ssd_size "$target_mount")"
  temp_live="$(get_temp_live)"
  temp_max="$(get_temp_max)"
  temp_avg="$(get_temp_avg)"
  swap_used_mb="$(get_swap_used_mb)"
  disk_pct_num="$(get_disk_pct_num "$target_mount")"
  bat_pct_num="$(get_battery_pct_num)"
  [ -z "$swap_used_mb" ] && swap_used_mb=0

  # Strict JSON escaping for potentially untrusted hardware string outputs
  local json_chip="${chip//\\/\\\\}"
  json_chip="${json_chip//\"/\\\"}"
  local json_ram="${ram//\\/\\\\}"
  json_ram="${json_ram//\"/\\\"}"
  local json_ssd="${ssd//\\/\\\\}"
  json_ssd="${json_ssd//\"/\\\"}"

  # A reading this machine can't take is `null`, not the string "N/A": a consumer
  # doing arithmetic on "N/A" gets a silent zero, which is the same class of lie
  # as a size column holding a count.
  jnum() { case "${1:-}" in ''|N/A|*[!0-9.]*) printf 'null' ;; *) printf '%s' "$1" ;; esac; }

  cat <<EOF
{
  "version": "${VERSION}",
  "os": "$(uname)",
  "chip": "${json_chip}",
  "ram": "${json_ram}",
  "ssd": "${json_ssd}",
  "swap_used_mb": $(jnum "$swap_used_mb"),
  "mem_available_pct": $(jnum "$(get_mem_avail_pct)"),
  "disk_used_pct": $(jnum "$disk_pct_num"),
  "battery_health_pct": $(jnum "$bat_pct_num"),
  "temp_live_c": $(jnum "$temp_live"),
  "temp_avg_c": $(jnum "$temp_avg"),
  "temp_max_c": $(jnum "$temp_max"),
  "verdict": {
    "memory": "$(verdict_memory_both "$swap_used_mb" "$(get_ram_mb)" "$(get_mem_avail_pct)")",
    "storage": "$(verdict_storage "$disk_pct_num")",
    "battery": "$(verdict_battery "$bat_pct_num")"
  }
}
EOF
}

# CLI Router
# Sourced as a library for tests (SHEERSTATUS_LIB=1): every function above is
# defined, and nothing runs. The sibling carries the same guard, for the same
# reason — a verdict you cannot call directly is a verdict you can only test by
# owning a machine that happens to be in the tier you want to check.
# shellcheck disable=SC2317  # the exit is reached only when run (not sourced) under the flag
if [ -n "${SHEERSTATUS_LIB:-}" ]; then return 0 2>/dev/null || exit 0; fi

case "${1:-}" in
  --json)
    run_json
    ;;
  --version|-v)
    echo "sheerstatus v${VERSION}"
    ;;
  --help|-h)
    echo "sheerstatus — the zero-daemon hardware & pre-upgrade auditor you can read."
    echo ""
    echo "Usage:"
    echo "  sheerstatus              Print hardware health & audit verdict"
    echo "  sheerstatus --json       Output JSON for automation"
    echo "  sheerstatus --version    Print version"
    echo "  sheerstatus --help       Print help"
    ;;
  *)
    run_audit
    ;;
esac
