# --- Format Helper ---

# A group header (Signet CLI): ▸ Title, with its rows directly beneath. The mark
# lives here rather than inside each translated string — one place instead of
# forty, and a new locale can't forget it. Bold or a rule would say the same
# thing to a terminal and nothing at all to a file.
sec() { printf '▸ %s\n' "$1"; }

# The colon rule lives in t sep_colon, not here. It was written out inline in
# this function AND inside every verdict line, which is how French ended up
# correct in one place and wrong in the other.
pad_row() {
  local label="$1"
  local val="$2"
  printf '   · %s%s%s\n' "$label" "$(t sep_colon)" "$val"
}

# --- Target Storage Mount Resolver (Prevents network hang & targets max user partition) ---

get_target_mount() {
  if [ "$(uname)" = "Darwin" ]; then
    if [ -d "/System/Volumes/Data" ]; then
      echo "/System/Volumes/Data"
    else
      echo "/"
    fi
  else
    # Linux: Check both / and $HOME partition using local-only df (-hl), pick highest usage %
    local home_dir="${HOME:-/}"
    local root_pct home_pct
    root_pct="$(df -P -k / 2>/dev/null | awk 'NR==2 {print $5}' | tr -d '%' || echo 0)"
    home_pct="$(df -P -k "$home_dir" 2>/dev/null | awk 'NR==2 {print $5}' | tr -d '%' || echo 0)"
    [ -z "$root_pct" ] && root_pct=0
    [ -z "$home_pct" ] && home_pct=0

    if [ "$home_pct" -gt "$root_pct" ]; then
      echo "$home_dir"
    else
      echo "/"
    fi
  fi
}

# --- Cross-Platform Metrics (macOS + Linux) ---

get_chip_name() {
  if [ "$(uname)" = "Darwin" ]; then
    sysctl -n machdep.cpu.brand_string 2>/dev/null || sysctl -n hw.model 2>/dev/null || echo "Apple Silicon"
  else
    local cpu_name
    cpu_name="$(grep -m1 "model name" /proc/cpuinfo 2>/dev/null | cut -d: -f2 | awk '{$1=$1};1' || true)"
    if [ -z "$cpu_name" ] && [ -f /sys/firmware/devicetree/base/model ]; then
      cpu_name="$(tr -d '\0' < /sys/firmware/devicetree/base/model 2>/dev/null || true)"
    fi
    [ -z "$cpu_name" ] && cpu_name="$(uname -m 2>/dev/null || echo "Linux Processor")"
    echo "$cpu_name"
  fi
}

get_ram_gb() {
  if [ "$(uname)" = "Darwin" ]; then
    local bytes gb
    bytes="$(sysctl -n hw.memsize 2>/dev/null || echo 0)"
    gb=$(( bytes / 1073741824 ))
    echo "${gb} GB"
  else
    local kb gb
    kb="$(awk '/MemTotal:/ {print $2}' /proc/meminfo 2>/dev/null || echo 0)"
    gb=$(( kb / 1048576 ))
    echo "${gb} GB"
  fi
}

get_ram_mb() {
  if [ "$(uname)" = "Darwin" ]; then
    local bytes
    bytes="$(sysctl -n hw.memsize 2>/dev/null || echo 0)"
    echo $(( bytes / 1048576 ))
  else
    local kb
    kb="$(awk '/MemTotal:/ {print $2}' /proc/meminfo 2>/dev/null || echo 0)"
    echo $(( kb / 1024 ))
  fi
}

get_ssd_size() {
  local mount_path="${1:-$(get_target_mount)}"
  local kb gb
  
  kb="$(df -P -k "$mount_path" 2>/dev/null | awk 'NR==2 {print $2}')"
  [ -z "$kb" ] && kb=0
  # Storage is DECIMAL — diskutil, Finder and System Settings all say 245.1 GB
  # for the volume `df -h` calls 228Gi, and those are the numbers the owner can
  # check us against. (Memory is the other way: hw.memsize / 1024³ is the 16 GB
  # that About This Mac shows, and vm.swapusage reports binary M too. The base
  # follows the DOMAIN, not the tool.) df gives 1024-byte blocks, so ×1024 ÷1000³.
  gb="$(awk -v k="$kb" 'BEGIN{printf "%.0f", k * 1024 / 1000000000}')"

  echo "${gb} GB"
}

get_swap_formatted() {
  if [ "$(uname)" = "Darwin" ]; then
    local swap_line used_mb used_gb
    swap_line="$(sysctl -n vm.swapusage 2>/dev/null || echo "")"
    if [ -z "$swap_line" ]; then
      echo "N/A"
      return
    fi
    used_mb="$(echo "$swap_line" | awk '{for(i=1;i<=NF;i++) if($i=="used") print $(i+2)}' | tr -d 'M' | cut -d. -f1)"
    [ -z "$used_mb" ] && used_mb=0

    if [ "$used_mb" -eq 0 ]; then
      echo "0 B"
    else
      used_gb="$(awk "BEGIN {printf \"%.2f\", $used_mb/1024}")"
      echo "${used_gb} GB"
    fi
  else
    local st_kb sf_kb su_kb used_gb
    st_kb="$(awk '/SwapTotal:/ {print $2}' /proc/meminfo 2>/dev/null || echo 0)"
    sf_kb="$(awk '/SwapFree:/ {print $2}' /proc/meminfo 2>/dev/null || echo 0)"
    su_kb=$(( st_kb - sf_kb ))
    [ "$su_kb" -lt 0 ] && su_kb=0

    if [ "$su_kb" -eq 0 ]; then
      echo "0 B"
    else
      used_gb="$(awk "BEGIN {printf \"%.2f\", $su_kb/1048576}")"
      echo "${used_gb} GB"
    fi
  fi
}

get_disk_formatted() {
  local mount_path="${1:-$(get_target_mount)}"
  local kb gb
  
  kb="$(df -P -k "$mount_path" 2>/dev/null | awk 'NR==2 {print $3}')"
  [ -z "$kb" ] && kb=0
  gb="$(awk -v k="$kb" 'BEGIN{printf "%.0f", k * 1024 / 1000000000}')"   # decimal — see get_disk_total

  echo "${gb} GB"
}

get_disk_pct_num() {
  local mount_path="${1:-$(get_target_mount)}"
  df -P -k "$mount_path" 2>/dev/null | awk 'NR==2 {print $5}' | tr -d '%' | cut -d. -f1
}

get_temp_live() {
  if [ "$(uname)" = "Darwin" ]; then
    local raw
    raw="$(ioreg -rn AppleSmartBattery 2>/dev/null | awk -F'= ' '/"Temperature" =/ {print $2}' | head -n1)"
    if [ -n "$raw" ]; then
      awk "BEGIN {printf \"%.1f\", $raw/100}"
    else
      echo "N/A"
    fi
  else
    local t_path=""
    for bat_path in /sys/class/power_supply/*; do
      if [ -d "$bat_path" ] && [ "$(cat "$bat_path/type" 2>/dev/null)" = "Battery" ]; then
        if [ -f "$bat_path/temp" ]; then
          t_path="$bat_path/temp"
          break
        fi
      fi
    done
    if [ -n "$t_path" ] && [ -f "$t_path" ]; then
      local raw
      raw="$(cat "$t_path" 2>/dev/null || echo 0)"
      awk "BEGIN {printf \"%.1f\", $raw/10}"
    else
      echo "N/A"
    fi
  fi
}

get_temp_max() {
  if [ "$(uname)" = "Darwin" ]; then
    local raw
    raw="$(ioreg -rn AppleSmartBattery 2>/dev/null | tr -d ' ' | grep -o '"MaximumTemperature"=[0-9]*' | cut -d= -f2 | head -n1 || true)"
    if [ -n "$raw" ]; then
      echo "${raw}"
    else
      echo "N/A"
    fi
  else
    echo "N/A"
  fi
}

get_temp_avg() {
  if [ "$(uname)" = "Darwin" ]; then
    local raw
    raw="$(ioreg -rn AppleSmartBattery 2>/dev/null | tr -d ' ' | grep -o '"AverageTemperature"=[0-9]*' | cut -d= -f2 | head -n1 || true)"
    if [ -n "$raw" ]; then
