    fi
  else
    echo "N/A"
  fi
}

get_battery_pct() {
  if [ "$(uname)" = "Darwin" ]; then
    local raw_max max_cap design_cap
    raw_max="$(ioreg -rn AppleSmartBattery 2>/dev/null | tr -d ' ' | grep -o '"AppleRawMaxCapacity"=[0-9]*' | cut -d= -f2 | head -n1 || true)"
    design_cap="$(ioreg -rn AppleSmartBattery 2>/dev/null | tr -d ' ' | grep -o '"DesignCapacity"=[0-9]*' | cut -d= -f2 | head -n1 || true)"
    
    if [ -n "$raw_max" ] && [ -n "$design_cap" ] && [ "$design_cap" -gt 0 ]; then
      local pct=$(( raw_max * 100 / design_cap ))
      [ "$pct" -gt 100 ] && pct=100
      echo "${pct}%"
    else
      max_cap="$(ioreg -rn AppleSmartBattery 2>/dev/null | tr -d ' ' | grep -o '"MaxCapacity"=[0-9]*' | cut -d= -f2 | head -n1 || true)"
      if [ -n "$max_cap" ]; then
        echo "${max_cap}%"
      else
        echo "N/A"
      fi
    fi
  else
    local health_pct=0 count=0
    for bat_path in /sys/class/power_supply/*; do
      if [ -d "$bat_path" ] && [ "$(cat "$bat_path/type" 2>/dev/null)" = "Battery" ]; then
        local full=0 full_design=0
        if [ -f "$bat_path/energy_full" ] && [ -f "$bat_path/energy_full_design" ]; then
          full="$(cat "$bat_path/energy_full" 2>/dev/null || echo 0)"
          full_design="$(cat "$bat_path/energy_full_design" 2>/dev/null || echo 0)"
        elif [ -f "$bat_path/charge_full" ] && [ -f "$bat_path/charge_full_design" ]; then
          full="$(cat "$bat_path/charge_full" 2>/dev/null || echo 0)"
          full_design="$(cat "$bat_path/charge_full_design" 2>/dev/null || echo 0)"
        fi

        if [ -n "$full_design" ] && [ "$full_design" -gt 0 ]; then
          local pct=$(( full * 100 / full_design ))
          [ "$pct" -gt 100 ] && pct=100
          health_pct=$(( health_pct + pct ))
          count=$(( count + 1 ))
        fi
      fi
    done
    if [ "$count" -gt 0 ]; then
      echo "$(( health_pct / count ))%"
    else
      echo "N/A"
    fi
  fi
}

get_battery_capacity_string() {
  if [ "$(uname)" = "Darwin" ]; then
    local raw_max design_cap
    raw_max="$(ioreg -rn AppleSmartBattery 2>/dev/null | tr -d ' ' | grep -o '"AppleRawMaxCapacity"=[0-9]*' | cut -d= -f2 | head -n1 || true)"
    design_cap="$(ioreg -rn AppleSmartBattery 2>/dev/null | tr -d ' ' | grep -o '"DesignCapacity"=[0-9]*' | cut -d= -f2 | head -n1 || true)"
    
    if [ -n "$raw_max" ] && [ -n "$design_cap" ] && [ "$design_cap" -gt 0 ]; then
      echo "${raw_max} / ${design_cap} mAh"
    else
      echo "N/A"
    fi
  else
    local total_full=0 total_design=0 is_energy=0 count=0
    for bat_path in /sys/class/power_supply/*; do
      if [ -d "$bat_path" ] && [ "$(cat "$bat_path/type" 2>/dev/null)" = "Battery" ]; then
        local full=0 full_design=0
        if [ -f "$bat_path/energy_full" ] && [ -f "$bat_path/energy_full_design" ]; then
          full="$(cat "$bat_path/energy_full" 2>/dev/null || echo 0)"
          full_design="$(cat "$bat_path/energy_full_design" 2>/dev/null || echo 0)"
          is_energy=1
        elif [ -f "$bat_path/charge_full" ] && [ -f "$bat_path/charge_full_design" ]; then
          full="$(cat "$bat_path/charge_full" 2>/dev/null || echo 0)"
          full_design="$(cat "$bat_path/charge_full_design" 2>/dev/null || echo 0)"
        fi

        if [ -n "$full_design" ] && [ "$full_design" -gt 0 ]; then
          total_full=$(( total_full + full ))
          total_design=$(( total_design + full_design ))
          count=$(( count + 1 ))
        fi
      fi
    done
    if [ "$count" -gt 0 ]; then
      local val_full=$(( total_full / 1000 ))
      local val_design=$(( total_design / 1000 ))
      if [ "$is_energy" -eq 1 ]; then
        echo "${val_full} / ${val_design} mWh"
      else
        echo "${val_full} / ${val_design} mAh"
      fi
    else
      echo "N/A"
    fi
  fi
}

get_battery_pct_num() {
  get_battery_pct | tr -d '%' | cut -d. -f1
}

get_battery_cycles() {
  if [ "$(uname)" = "Darwin" ]; then
    local cycle_cnt
    cycle_cnt="$(ioreg -rn AppleSmartBattery 2>/dev/null | tr -d ' ' | grep -o '"CycleCount"=[0-9]*' | cut -d= -f2 | head -n1 || true)"
    if [ -n "$cycle_cnt" ]; then
      echo "${cycle_cnt}"
    else
      echo "N/A"
    fi
  else
    local total_cycles=0 count=0 cyc
