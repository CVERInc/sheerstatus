    zh-TW|zh-Hans|ja-JP) echo "  • ${label}：${val}" ;;
    *) echo "  • ${label}: ${val}" ;;
  esac
}

# --- Target Storage Mount Resolver (Prevents network hang & targets max user partition) ---

get_target_mount() {
  if [ "$(uname)" = "Darwin" ]; then
    if [ -d "/System/Volumes/Data" ]; then
      echo "/System/Volumes/Data"
    else
      echo "/"
    fi
  else
    # Linux: Check both / and $HOME partition using local-only df (-hl), pick highest usage %
    local home_dir="${HOME:-/}"
    local root_pct home_pct
    root_pct="$(df -P -k / 2>/dev/null | awk 'NR==2 {print $5}' | tr -d '%' || echo 0)"
    home_pct="$(df -P -k "$home_dir" 2>/dev/null | awk 'NR==2 {print $5}' | tr -d '%' || echo 0)"
    [ -z "$root_pct" ] && root_pct=0
    [ -z "$home_pct" ] && home_pct=0

    if [ "$home_pct" -gt "$root_pct" ]; then
      echo "$home_dir"
    else
      echo "/"
    fi
  fi
}

# --- Cross-Platform Metrics (macOS + Linux) ---

get_chip_name() {
  if [ "$(uname)" = "Darwin" ]; then
    sysctl -n machdep.cpu.brand_string 2>/dev/null || sysctl -n hw.model 2>/dev/null || echo "Apple Silicon"
  else
    local cpu_name
    cpu_name="$(grep -m1 "model name" /proc/cpuinfo 2>/dev/null | cut -d: -f2 | sed 's/^\s*//' || true)"
    if [ -z "$cpu_name" ] && [ -f /sys/firmware/devicetree/base/model ]; then
      cpu_name="$(tr -d '\0' < /sys/firmware/devicetree/base/model 2>/dev/null || true)"
    fi
    [ -z "$cpu_name" ] && cpu_name="$(uname -m 2>/dev/null || echo "Linux Processor")"
    echo "$cpu_name"
  fi
}

get_ram_gb() {
  if [ "$(uname)" = "Darwin" ]; then
    local bytes gb
    bytes="$(sysctl -n hw.memsize 2>/dev/null || echo 0)"
    gb=$(( bytes / 1073741824 ))
    echo "${gb} GB"
  else
    local kb gb
    kb="$(awk '/MemTotal:/ {print $2}' /proc/meminfo 2>/dev/null || echo 0)"
    gb=$(( kb / 1048576 ))
    echo "${gb} GB"
  fi
}

get_ram_mb() {
  if [ "$(uname)" = "Darwin" ]; then
    local bytes
    bytes="$(sysctl -n hw.memsize 2>/dev/null || echo 0)"
    echo $(( bytes / 1048576 ))
  else
    local kb
    kb="$(awk '/MemTotal:/ {print $2}' /proc/meminfo 2>/dev/null || echo 0)"
    echo $(( kb / 1024 ))
  fi
}

get_ssd_size() {
  local mount_path="${1:-$(get_target_mount)}"
  local kb gb
  
  kb="$(df -P -k "$mount_path" 2>/dev/null | awk 'NR==2 {print $2}')"
  [ -z "$kb" ] && kb=0
  gb=$(( kb / 1048576 ))

  echo "${gb} GB"
}

get_swap_formatted() {
  if [ "$(uname)" = "Darwin" ]; then
    local swap_line used_mb used_gb
    swap_line="$(sysctl -n vm.swapusage 2>/dev/null || echo "")"
    if [ -z "$swap_line" ]; then
      echo "N/A"
      return
    fi
    used_mb="$(echo "$swap_line" | awk '{for(i=1;i<=NF;i++) if($i=="used") print $(i+2)}' | tr -d 'M' | cut -d. -f1)"
    [ -z "$used_mb" ] && used_mb=0

    if [ "$used_mb" -eq 0 ]; then
      echo "0 B"
    else
      used_gb="$(awk "BEGIN {printf \"%.2f\", $used_mb/1024}")"
      echo "${used_gb} GB"
    fi
  else
    local st_kb sf_kb su_kb used_gb
    st_kb="$(awk '/SwapTotal:/ {print $2}' /proc/meminfo 2>/dev/null || echo 0)"
    sf_kb="$(awk '/SwapFree:/ {print $2}' /proc/meminfo 2>/dev/null || echo 0)"
    su_kb=$(( st_kb - sf_kb ))
    [ "$su_kb" -lt 0 ] && su_kb=0

    if [ "$su_kb" -eq 0 ]; then
      echo "0 B"
    else
      used_gb="$(awk "BEGIN {printf \"%.2f\", $su_kb/1048576}")"
      echo "${used_gb} GB"
    fi
  fi
}

get_disk_formatted() {
  local mount_path="${1:-$(get_target_mount)}"
  local kb gb
  
  kb="$(df -P -k "$mount_path" 2>/dev/null | awk 'NR==2 {print $3}')"
  [ -z "$kb" ] && kb=0
  gb=$(( kb / 1048576 ))

  echo "${gb} GB"
}

get_disk_pct_num() {
  local mount_path="${1:-$(get_target_mount)}"
  df -P -k "$mount_path" 2>/dev/null | awk 'NR==2 {print $5}' | tr -d '%' | cut -d. -f1
}

get_temp_live() {
  if [ "$(uname)" = "Darwin" ]; then
    local raw
    raw="$(ioreg -rn AppleSmartBattery 2>/dev/null | awk -F'= ' '/"Temperature" =/ {print $2}' | head -n1)"
    if [ -n "$raw" ]; then
      awk "BEGIN {printf \"%.1f\", $raw/100}"
    else
      echo "N/A"
    fi
  else
    local t_path
    t_path="$(ls /sys/class/power_supply/*/temp 2>/dev/null | head -n1 || true)"
    if [ -n "$t_path" ] && [ -f "$t_path" ]; then
      local raw
      raw="$(cat "$t_path" 2>/dev/null || echo 0)"
      awk "BEGIN {printf \"%.1f\", $raw/10}"
    else
      echo "N/A"
    fi
  fi
}

get_temp_max() {
  if [ "$(uname)" = "Darwin" ]; then
    local raw
    raw="$(ioreg -rn AppleSmartBattery 2>/dev/null | grep -o '"MaximumTemperature"=[0-9]*' | cut -d= -f2 | head -n1 || true)"
    if [ -n "$raw" ]; then
      echo "${raw} °C"
    else
      echo "N/A"
    fi
  else
    echo "N/A"
  fi
}

get_temp_avg() {
  if [ "$(uname)" = "Darwin" ]; then
    local raw
    raw="$(ioreg -rn AppleSmartBattery 2>/dev/null | grep -o '"AverageTemperature"=[0-9]*' | cut -d= -f2 | head -n1 || true)"
    if [ -n "$raw" ]; then
      awk "BEGIN {printf \"%.1f\", $raw/10}"
    else
      echo "N/A"
    fi
  else
    echo "N/A"
  fi
}

get_battery_pct() {
  if [ "$(uname)" = "Darwin" ]; then
    local raw_max max_cap design_cap
    raw_max="$(ioreg -rn AppleSmartBattery 2>/dev/null | grep -o '"AppleRawMaxCapacity"=[0-9]*' | cut -d= -f2 | head -n1 || true)"
    design_cap="$(ioreg -rn AppleSmartBattery 2>/dev/null | grep -o '"DesignCapacity"=[0-9]*' | cut -d= -f2 | head -n1 || true)"
    
    if [ -n "$raw_max" ] && [ -n "$design_cap" ] && [ "$design_cap" -gt 0 ]; then
      local pct=$(( raw_max * 100 / design_cap ))
      [ "$pct" -gt 100 ] && pct=100
      echo "${pct}%"
    else
      max_cap="$(ioreg -rn AppleSmartBattery 2>/dev/null | grep -o '"MaxCapacity"=[0-9]*' | cut -d= -f2 | head -n1 || true)"
      if [ -n "$max_cap" ]; then
        echo "${max_cap}%"
      else
        echo "N/A"
      fi
    fi
  else
    local caps=0 count=0 cap
    for cap_path in /sys/class/power_supply/*/capacity; do
      if [ -f "$cap_path" ]; then
        cap="$(cat "$cap_path" 2>/dev/null || echo 0)"
        caps=$(( caps + cap ))
        count=$(( count + 1 ))
      fi
    done
    if [ "$count" -gt 0 ]; then
      local avg_cap=$(( caps / count ))
      echo "${avg_cap}%"
    else
      echo "N/A"
    fi
  fi
}

get_battery_pct_num() {
  get_battery_pct | tr -d '%' | cut -d. -f1
}

get_battery_cycles() {
  if [ "$(uname)" = "Darwin" ]; then
    local cycle_cnt
    cycle_cnt="$(ioreg -rn AppleSmartBattery 2>/dev/null | grep -o '"CycleCount"=[0-9]*' | cut -d= -f2 | head -n1 || true)"
    if [ -n "$cycle_cnt" ]; then
      echo "${cycle_cnt}"
    else
      echo "N/A"
    fi
  else
    local total_cycles=0 count=0 cyc
    for cyc_path in /sys/class/power_supply/*/cycle_count; do
      if [ -f "$cyc_path" ]; then
        cyc="$(cat "$cyc_path" 2>/dev/null || echo 0)"
        if [ "$cyc" -gt 0 ]; then
          total_cycles=$(( total_cycles + cyc ))
          count=$(( count + 1 ))
        fi
      fi
    done
    if [ "$count" -gt 0 ]; then
      echo "${total_cycles}"
    else
      echo "N/A"
    fi
  fi
}

get_swap_used_mb() {
  if [ "$(uname)" = "Darwin" ]; then
    sysctl -n vm.swapusage 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="used") print $(i+2)}' | tr -d 'M' | cut -d. -f1
  else
    local st_kb sf_kb su_kb
    st_kb="$(awk '/SwapTotal:/ {print $2}' /proc/meminfo 2>/dev/null || echo 0)"
    sf_kb="$(awk '/SwapFree:/ {print $2}' /proc/meminfo 2>/dev/null || echo 0)"
    su_kb=$(( st_kb - sf_kb ))
    [ "$su_kb" -lt 0 ] && su_kb=0
    echo $(( su_kb / 1024 ))
  fi
}

# --- Audit Verdict Builder ---

build_verdict_line_memory() {
  local swap_mb swap_fmt ram_mb
  swap_mb="$1"
  ram_mb="$2"
  swap_fmt="$(get_swap_formatted)"

  # Future-proof ratio thresholds (5% and 20% of total physical RAM)
  local pass_threshold=$(( ram_mb * 5 / 100 ))
  local warn_threshold=$(( ram_mb * 20 / 100 ))

  # Base sanity bounds for extreme low-end hardware
  [ "$pass_threshold" -lt 200 ] && pass_threshold=200
  [ "$warn_threshold" -lt 500 ] && warn_threshold=500

  if [ "$swap_mb" -lt "$pass_threshold" ]; then
    case "$SS_LANG" in
      zh-TW|zh-Hans) echo "  • $(t tag_pass) $(t name_memory)：未啟用虛擬記憶體（${swap_fmt}）。" ;;
      ja-JP) echo "  • $(t tag_pass) $(t name_memory)：仮想メモリは未使用です（${swap_fmt}）。" ;;
      ko-KR) echo "  • $(t tag_pass) $(t name_memory)：가상 메모리를 사용하지 않음（${swap_fmt}）。" ;;
      *) echo "  • $(t tag_pass) $(t name_memory): Virtual memory inactive (${swap_fmt})." ;;
    esac
  elif [ "$swap_mb" -lt 3000 ]; then
    case "$SS_LANG" in
      zh-TW|zh-Hans) echo "  • $(t tag_warn) $(t name_memory)：已開始將硬碟當作虛擬記憶體（已用 ${swap_fmt}）。" ;;
      ja-JP) echo "  • $(t tag_warn) $(t name_memory)：ストレージを仮想メモリとして使用し始めました（使用済み ${swap_fmt}）。" ;;
      ko-KR) echo "  • $(t tag_warn) $(t name_memory)：스토리지를 가상 메모리로 사용하기 시작함（사용됨 ${swap_fmt}）。" ;;
      *) echo "  • $(t tag_warn) $(t name_memory): Started using disk as virtual memory (${swap_fmt} used)." ;;
    esac
  else
    case "$SS_LANG" in
      zh-TW|zh-Hans) echo "  • $(t tag_crit) $(t name_memory)：虛擬記憶體持續大量讀寫硬碟，將導致折壽（已用 ${swap_fmt}）。" ;;
      ja-JP) echo "  • $(t tag_crit) $(t name_memory)：仮想メモリによるストレージの大量読み書きは寿命を縮めます（使用済み ${swap_fmt}）。" ;;
      ko-KR) echo "  • $(t tag_crit) $(t name_memory)：가상 메모리의 과도한 스토리지 읽기/쓰기는 수명을 단축시킴（사용됨 ${swap_fmt}）。" ;;
      *) echo "  • $(t tag_crit) $(t name_memory): Heavy virtual memory thrashing will degrade disk lifespan (${swap_fmt} used)." ;;
    esac
  fi
}

build_verdict_line_storage() {
  local disk_pct
  disk_pct="$1"

  if [ "$disk_pct" -lt 85 ]; then
    case "$SS_LANG" in
      zh-TW|zh-Hans) echo "  • $(t tag_pass) $(t name_storage)：空間充裕（已用 ${disk_pct}%）。" ;;
      ja-JP) echo "  • $(t tag_pass) $(t name_storage)：容量は十分です（使用済み ${disk_pct}%）。" ;;
      ko-KR) echo "  • $(t tag_pass) $(t name_storage)：공간이 충분합니다(사용됨 ${disk_pct}%)." ;;
      *) echo "  • $(t tag_pass) $(t name_storage): Ample capacity (${disk_pct}% used)." ;;
    esac
  elif [ "$disk_pct" -lt 95 ]; then
    case "$SS_LANG" in
      zh-TW|zh-Hans) echo "  • $(t tag_warn) $(t name_storage)：空間不足，接近降速臨界點（已用 ${disk_pct}%）。" ;;
      ja-JP) echo "  • $(t tag_warn) $(t name_storage)：容量不足、速度低下閾値に接近（使用済み ${disk_pct}%）。" ;;
      ko-KR) echo "  • $(t tag_warn) $(t name_storage)：공간 부족, 속도 저하 임계점 접근(사용됨 ${disk_pct}%)." ;;
      *) echo "  • $(t tag_warn) $(t name_storage): Low capacity, near throttling threshold (${disk_pct}% used)." ;;
    esac
  else
    case "$SS_LANG" in
      zh-TW|zh-Hans) echo "  • $(t tag_crit) $(t name_storage)：嚴重不足，已達降速狀態（已用 ${disk_pct}%）。" ;;
      ja-JP) echo "  • $(t tag_crit) $(t name_storage)：深刻な容量不足（使用済み ${disk_pct}%）。" ;;
      ko-KR) echo "  • $(t tag_crit) $(t name_storage)：공간 심각 부족(사용됨 ${disk_pct}%)." ;;
      *) echo "  • $(t tag_crit) $(t name_storage): Severe storage deficit (${disk_pct}% used)." ;;
    esac
  fi
}

