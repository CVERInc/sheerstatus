# --- Gather Metrics ---

get_chip_name() {
  local chip
  chip="$(sysctl -n machdep.cpu.brand_string 2>/dev/null || sysctl -n hw.model 2>/dev/null || echo "Apple Silicon")"
  echo "$chip"
}

get_ram_gb() {
  local bytes gb
  bytes="$(sysctl -n hw.memsize 2>/dev/null || echo 0)"
  gb=$(( bytes / 1073741824 ))
  echo "${gb} GB"
}

get_ssd_size() {
  local raw_df
  raw_df="$(df -h /System/Volumes/Data 2>/dev/null | awk 'NR==2 {print $2}')"
  case "$raw_df" in
    *Gi|*G) echo "${raw_df%Gi} GB SSD" ;;
    *Ti|*T) echo "${raw_df%Ti} TB SSD" ;;
    *) echo "${raw_df} SSD" ;;
  esac
}

get_swap() {
  sysctl -n vm.swapusage 2>/dev/null || echo "N/A"
}

get_temp_live() {
  local raw
  raw="$(ioreg -rn AppleSmartBattery 2>/dev/null | grep -o '"Temperature"=[0-9]*' | cut -d= -f2 || true)"
  if [ -n "$raw" ]; then
    awk "BEGIN {printf \"%.1f\", $raw/100}"
  else
    echo "N/A"
  fi
}

get_temp_max() {
  local raw
  raw="$(ioreg -rn AppleSmartBattery 2>/dev/null | grep -o '"MaximumTemperature"=[0-9]*' | cut -d= -f2 || true)"
  if [ -n "$raw" ]; then
    echo "${raw} °C"
  else
    echo "N/A"
  fi
}

get_temp_avg() {
  local raw
  raw="$(ioreg -rn AppleSmartBattery 2>/dev/null | grep -o '"AverageTemperature"=[0-9]*' | cut -d= -f2 || true)"
  if [ -n "$raw" ]; then
    awk "BEGIN {printf \"%.1f\", $raw/10}"
  else
    echo "N/A"
  fi
}

get_battery_health() {
  local raw_max max_cap design_cap cycle_cnt
  raw_max="$(ioreg -rn AppleSmartBattery 2>/dev/null | grep -o '"AppleRawMaxCapacity"=[0-9]*' | cut -d= -f2 | head -n1 || true)"
  design_cap="$(ioreg -rn AppleSmartBattery 2>/dev/null | grep -o '"DesignCapacity"=[0-9]*' | cut -d= -f2 | head -n1 || true)"
  cycle_cnt="$(ioreg -rn AppleSmartBattery 2>/dev/null | grep -o '"CycleCount"=[0-9]*' | cut -d= -f2 | head -n1 || true)"
  
  if [ -n "$raw_max" ] && [ -n "$design_cap" ] && [ "$design_cap" -gt 0 ]; then
    local pct=$(( raw_max * 100 / design_cap ))
    [ "$pct" -gt 100 ] && pct=100
    if [ -n "$cycle_cnt" ]; then
      echo "${pct}% (${cycle_cnt} $(t label_cycles))"
    else
      echo "${pct}%"
    fi
  else
    max_cap="$(ioreg -rn AppleSmartBattery 2>/dev/null | grep -o '"MaxCapacity"=[0-9]*' | cut -d= -f2 | head -n1 || true)"
    if [ -n "$max_cap" ]; then
      echo "${max_cap}% (${cycle_cnt} $(t label_cycles))"
    else
      echo "N/A"
    fi
  fi
}

get_swap_used_mb() {
  sysctl -n vm.swapusage 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="used") print $(i+2)}' | tr -d 'M' | cut -d. -f1
}

# --- Run Audit Output ---

run_audit() {
  local chip ram ssd swap_info temp_live temp_max temp_avg bat_health swap_used_mb
  chip="$(get_chip_name)"
  ram="$(get_ram_gb)"
  ssd="$(get_ssd_size)"
  swap_info="$(get_swap)"
  temp_live="$(get_temp_live)"
  temp_max="$(get_temp_max)"
  temp_avg="$(get_temp_avg)"
  bat_health="$(get_battery_health)"
  swap_used_mb="$(get_swap_used_mb)"
  [ -z "$swap_used_mb" ] && swap_used_mb=0

  echo "============================================================"
  t banner_title
  echo "============================================================"
  echo "  • $(t sec_header) : ${chip} (${ram} / ${ssd})"
  echo ""
  t sec_memory
  echo "  • $(t label_swap)       : ${swap_info}"
  
  local compressed_pages comp_gb
  compressed_pages="$(vm_stat 2>/dev/null | awk '/Pages stored in compressor/ {print $5}' | tr -d '.' || echo 0)"
  if [ "$compressed_pages" -gt 0 ]; then
    comp_gb="$(awk "BEGIN {printf \"%.1f\", $compressed_pages * 16384 / 1073741824}")"
    echo "  • $(t label_comp)   : ~${comp_gb} GB"
  fi
  echo ""

  t sec_thermal
  echo "  • $(t label_temp_live) : ${temp_live} °C"
  echo "  • $(t label_temp_avg) : ${temp_avg} (Max: ${temp_max})"
  echo "  • $(t label_battery)     : ${bat_health}"
  echo ""

  echo "------------------------------------------------------------"
  t verdict_title
  if [ "$swap_used_mb" -lt 500 ]; then
    t verdict_healthy "$ram"
  elif [ "$swap_used_mb" -lt 3000 ]; then
    t verdict_warning "$ram"
  else
    t verdict_critical "$ram"
  fi
  echo "------------------------------------------------------------"
  t footer_sheersweep
  echo "============================================================"
}

run_json() {
  local chip ram ssd temp_live temp_max temp_avg swap_used_mb
  chip="$(get_chip_name)"
  ram="$(get_ram_gb)"
  ssd="$(get_ssd_size)"
  temp_live="$(get_temp_live)"
  temp_max="$(get_temp_max)"
  temp_avg="$(get_temp_avg)"
  swap_used_mb="$(get_swap_used_mb)"
  [ -z "$swap_used_mb" ] && swap_used_mb=0

  cat <<EOF
{
  "version": "${VERSION}",
  "chip": "${chip}",
  "ram": "${ram}",
  "ssd": "${ssd}",
  "swap_used_mb": ${swap_used_mb},
  "temp_live_c": "${temp_live}",
  "temp_avg_c": "${temp_avg}",
  "temp_max_c": "${temp_max}"
}
EOF
}

# CLI Router
case "${1:-}" in
  --json)
    run_json
    ;;
  --version|-v)
    echo "sheerstatus v${VERSION}"
    ;;
  --help|-h)
    echo "sheerstatus — the Mac hardware & pre-upgrade auditor you can read."
    echo ""
    echo "Usage:"
    echo "  sheerstatus              Print hardware health & audit verdict"
    echo "  sheerstatus --json       Output JSON for automation"
    echo "  sheerstatus --version    Print version"
    echo "  sheerstatus --help       Print help"
    ;;
  *)
    run_audit
    ;;
esac
