      zh-TW|zh-Hans) echo "  • $(t tag_pass) $(t name_storage)：容量充裕（已用 ${disk_pct}%）。" ;;
      ja-JP) echo "  • $(t tag_pass) $(t name_storage)：容量は十分です（使用率 ${disk_pct}%）。" ;;
      ko-KR) echo "  • $(t tag_pass) $(t name_storage)：공간이 충분합니다(사용률 ${disk_pct}%)." ;;
      *) echo "  • $(t tag_pass) $(t name_storage): Ample capacity (${disk_pct}% used)." ;;
    esac
  elif [ "$disk_pct" -lt 95 ]; then
    case "$SS_LANG" in
      zh-TW|zh-Hans) echo "  • $(t tag_warn) $(t name_storage)：使用率已達 ${disk_fmt}，接近降速臨界點。" ;;
      ja-JP) echo "  • $(t tag_warn) $(t name_storage)：使用率 ${disk_fmt}、速度低下閾値に接近。" ;;
      ko-KR) echo "  • $(t tag_warn) $(t name_storage)：사용률 ${disk_fmt}, 속도 저하 임계점 접근." ;;
      *) echo "  • $(t tag_warn) $(t name_storage): Usage at ${disk_fmt}, near throttling threshold." ;;
    esac
  else
    case "$SS_LANG" in
      zh-TW|zh-Hans) echo "  • $(t tag_crit) $(t name_storage)：空間嚴重不足（使用率 ${disk_pct}%）。" ;;
      ja-JP) echo "  • $(t tag_crit) $(t name_storage)：容量深刻な不足（使用率 ${disk_pct}%）。" ;;
      ko-KR) echo "  • $(t tag_crit) $(t name_storage)：공간 심각 부족(사용률 ${disk_pct}%)." ;;
      *) echo "  • $(t tag_crit) $(t name_storage): Severe storage deficit (${disk_pct}% used)." ;;
    esac
  fi
}

build_verdict_line_battery() {
  local bat_pct bat_cycles
  bat_pct="$1"
  bat_cycles="$(get_battery_cycles)"

  if [ -z "$bat_pct" ] || [ "$bat_pct" = "N/A" ]; then
    return
  fi

  if [ "$bat_pct" -ge 80 ]; then
    case "$SS_LANG" in
      zh-TW|zh-Hans) echo "  • $(t tag_pass) $(t name_battery)：健康度 ${bat_pct}%（${bat_cycles}），狀況良好。" ;;
      ja-JP) echo "  • $(t tag_pass) $(t name_battery)：最大容量 ${bat_pct}%（${bat_cycles}）、良好。" ;;
      ko-KR) echo "  • $(t tag_pass) $(t name_battery)：성능 상태 ${bat_pct}%(${bat_cycles}), 양호." ;;
      *) echo "  • $(t tag_pass) $(t name_battery): Health ${bat_pct}% (${bat_cycles}), good condition." ;;
    esac
  elif [ "$bat_pct" -ge 70 ]; then
    case "$SS_LANG" in
      zh-TW|zh-Hans) echo "  • $(t tag_warn) $(t name_battery)：健康度已降至 ${bat_pct}%（${bat_cycles}）。" ;;
      ja-JP) echo "  • $(t tag_warn) $(t name_battery)：最大容量低下 ${bat_pct}%（${bat_cycles}）。" ;;
      ko-KR) echo "  • $(t tag_warn) $(t name_battery)：성능 저하 ${bat_pct}%(${bat_cycles})." ;;
      *) echo "  • $(t tag_warn) $(t name_battery): Health degraded to ${bat_pct}% (${bat_cycles})." ;;
    esac
  else
    case "$SS_LANG" in
      zh-TW|zh-Hans) echo "  • $(t tag_crit) $(t name_battery)：健康度嚴重衰退至 ${bat_pct}%（${bat_cycles}）。" ;;
      ja-JP) echo "  • $(t tag_crit) $(t name_battery)：バッテリー劣化 ${bat_pct}%（${bat_cycles}）。" ;;
      ko-KR) echo "  • $(t tag_crit) $(t name_battery)：배터리 심각 저하 ${bat_pct}%(${bat_cycles})." ;;
      *) echo "  • $(t tag_crit) $(t name_battery): Battery severely degraded to ${bat_pct}% (${bat_cycles})." ;;
    esac
  fi
}

build_consolidated_recommendation() {
  local swap_mb disk_pct bat_pct
  swap_mb="$1"
  disk_pct="$2"
  bat_pct="$3"
  [ -z "$bat_pct" ] || [ "$bat_pct" = "N/A" ] && bat_pct=100

  local need_ram=0 need_ssd=0 need_bat=0
  [ "$swap_mb" -ge 500 ] && need_ram=1
  [ "$disk_pct" -ge 85 ] && need_ssd=1
  [ "$bat_pct" -lt 80 ] && need_bat=1

  if [ "$need_ram" -eq 0 ] && [ "$need_ssd" -eq 0 ] && [ "$need_bat" -eq 0 ]; then
    case "$SS_LANG" in
      zh-TW|zh-Hans) echo "建議：硬體狀態極佳，目前完全無升級或換機需求。" ;;
      ja-JP) echo "推奨：ハードウェア状態は非常に良好です。買い替えの必要はありません。" ;;
      ko-KR) echo "권장: 하드웨어 상태가 매우 양호합니다. 현재 교체가 필요하지 않습니다." ;;
      *) echo "Recommendation: Hardware is in excellent condition. No upgrade needed." ;;
    esac
  else
    case "$SS_LANG" in
      zh-TW|zh-Hans)
        local rec="建議：若常態感覺延遲，下一台電腦建議選購"
        if [ "$need_ram" -eq 1 ] && [ "$need_ssd" -eq 1 ]; then
          rec="${rec}更高記憶體與儲存容量。"
        elif [ "$need_ram" -eq 1 ]; then
          rec="${rec}更高的記憶體規格。"
        elif [ "$need_ssd" -eq 1 ]; then
          rec="${rec}更高的儲存容量。"
        elif [ "$need_bat" -eq 1 ]; then
          rec="建議：更換電池或規劃更換新電腦。"
        fi
        echo "$rec"
        ;;
      ja-JP)
        local rec="推奨：日常の動作で遅延を感じる場合は、次回購入時に"
        if [ "$need_ram" -eq 1 ] && [ "$need_ssd" -eq 1 ]; then
          rec="${rec}上位のメモリおよびストレージ容量を推奨します。"
        elif [ "$need_ram" -eq 1 ]; then
          rec="${rec}上位のメモリ容量を推奨します。"
        elif [ "$need_ssd" -eq 1 ]; then
          rec="${rec}上位のストレージ容量を推奨します。"
        elif [ "$need_bat" -eq 1 ]; then
          rec="推奨：バッテリー交換または新しい PC への買い替えを検討してください。"
        fi
        echo "$rec"
        ;;
      *)
        local rec="Recommendation: If lag persists, consider opting for "
        if [ "$need_ram" -eq 1 ] && [ "$need_ssd" -eq 1 ]; then
          rec="${rec}a higher RAM tier and larger storage on your next machine."
        elif [ "$need_ram" -eq 1 ]; then
          rec="${rec}a higher RAM tier on your next machine."
        elif [ "$need_ssd" -eq 1 ]; then
          rec="${rec}larger storage on your next machine."
        elif [ "$need_bat" -eq 1 ]; then
          rec="Recommendation: Consider replacing the battery or upgrading to a new machine."
        fi
        echo "$rec"
        ;;
    esac
  fi
}

# --- Run Audit Output ---

run_audit() {
  local chip ram ssd swap_fmt disk_fmt temp_live temp_max temp_avg bat_pct bat_cycles swap_used_mb disk_pct_num bat_pct_num
  chip="$(get_chip_name)"
  ram="$(get_ram_gb)"
  ssd="$(get_ssd_size)"
  swap_fmt="$(get_swap_formatted)"
  disk_fmt="$(get_disk_formatted)"
  temp_live="$(get_temp_live)"
  temp_max="$(get_temp_max)"
  temp_avg="$(get_temp_avg)"
  bat_pct="$(get_battery_pct)"
  bat_cycles="$(get_battery_cycles)"
  swap_used_mb="$(get_swap_used_mb)"
  disk_pct_num="$(get_disk_pct_num)"
  bat_pct_num="$(get_battery_pct_num)"
  [ -z "$swap_used_mb" ] && swap_used_mb=0
  [ -z "$disk_pct_num" ] && disk_pct_num=0

  # Single Block Flush Output
  {
    echo "============================================================"
    t banner_title
    pad_row "$(t sec_header)" "${chip} (${ram} · ${ssd})"
    echo ""
    t sec_memory
    pad_row "$(t label_swap)" "${swap_fmt}"
    echo ""
    t sec_storage
    pad_row "$(t label_storage_usage)" "${disk_fmt}"
    if [ "$bat_pct" != "N/A" ] && [ -n "$bat_pct" ]; then
      echo ""
      t sec_battery
      pad_row "$(t label_temp_live)" "${temp_live} °C"
      if [ "$temp_avg" != "N/A" ]; then
        pad_row "$(t label_temp_avg)" "${temp_avg} °C"
      else
        pad_row "$(t label_temp_avg)" "N/A"
      fi
      pad_row "$(t label_temp_max)" "${temp_max}"
      pad_row "$(t label_battery_health)" "${bat_pct}"
      pad_row "$(t label_cycles)" "${bat_cycles}"
    fi
    echo ""
    echo "------------------------------------------------------------"
    t verdict_title
    build_verdict_line_memory "$swap_used_mb" "$ram"
    build_verdict_line_storage "$disk_pct_num"
    build_verdict_line_battery "$bat_pct_num"
    echo ""
    build_consolidated_recommendation "$swap_used_mb" "$disk_pct_num" "$bat_pct_num"
    echo "============================================================"
  }
}

run_json() {
  local chip ram ssd temp_live temp_max temp_avg swap_used_mb disk_pct_num bat_pct_num
  chip="$(get_chip_name)"
  ram="$(get_ram_gb)"
  ssd="$(get_ssd_size)"
  temp_live="$(get_temp_live)"
  temp_max="$(get_temp_max)"
  temp_avg="$(get_temp_avg)"
  swap_used_mb="$(get_swap_used_mb)"
  disk_pct_num="$(get_disk_pct_num)"
  bat_pct_num="$(get_battery_pct_num)"
  [ -z "$swap_used_mb" ] && swap_used_mb=0

  cat <<EOF
{
  "version": "${VERSION}",
  "os": "$(uname)",
  "chip": "${chip}",
  "ram": "${ram}",
  "ssd": "${ssd}",
  "swap_used_mb": ${swap_used_mb},
  "disk_used_pct": ${disk_pct_num},
  "battery_health_pct": "${bat_pct_num}",
  "temp_live_c": "${temp_live}",
  "temp_avg_c": "${temp_avg}",
  "temp_max_c": "${temp_max}"
}
EOF
}

# CLI Router
case "${1:-}" in
  --json)
    run_json
    ;;
  --version|-v)
    echo "sheerstatus v${VERSION}"
    ;;
  --help|-h)
    echo "sheerstatus — the zero-daemon hardware & pre-upgrade auditor you can read."
    echo ""
    echo "Usage:"
    echo "  sheerstatus              Print hardware health & audit verdict"
    echo "  sheerstatus --json       Output JSON for automation"
    echo "  sheerstatus --version    Print version"
    echo "  sheerstatus --help       Print help"
    ;;
  *)
    run_audit
    ;;
esac
